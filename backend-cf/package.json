{
  "name": "njau-esports-api",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "NJAU 电竞社官网后端（Cloudflare Worker + D1）",
  "scripts": {
    "test": "node test-api.mjs",
    "build": "node ../scripts/build.mjs",
    "dev": "npm run build && wrangler dev --local --port 8787",
